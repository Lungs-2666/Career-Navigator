// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Vacancy {
  id Int @id @default(autoincrement())
  title String 
  company String
  salaryMin Int?
  currency String @dafault("RUB")
  description String @db.Text
  skills Skill[] @relation("VacancySkills")
  url String @unique
  source String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id Int @id @default(autoincrement())
  name String @unique
  category String? 
  demand Float @default(0)
  vacancies Vacancy[] @relation("VacancySkills")
  createdAt DateTime @default(now())

}

model VacancySkill {
  vacancyId Int
  skillId int 
  vacancy Vacancy @relation(fields: [vacayId], reference: [id])
  skill Skill @relation(fields: [skillId], reference: [id])

  @@id([vacancyId, skillId])
}

model Course {
  id Int @id @default(autoincrement())
  title String 
  platform Srting 
  url String 
  price Int?
  skill Skill @relation(fields: [skillid], reference[id])
  skillId Int
  createdAt DateTime @default(now())
}
model User {
  id Int @id @default(autoincrement())
  email String @unique 
  name String?
  savedVacancies Vacancy[]
  savedSkills Skill[]
  createdAt DateTime @default(now())
}

model ParseLog{
  id Int @id @default(autoincrement())
  source String // "hh.ru"
  status String // "success" , "error"
  count Int // сколько вакансий 
  message String? // ошибка, если была
  createdAt DateTime @default(now())
}
